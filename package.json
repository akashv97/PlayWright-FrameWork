{
  "name": "playwright-framework",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node scripts/run-tests-with-allure.js",
    "test:raw": "npx cucumber-js --require-module ts-node/register --require ./step-definitions/**/*.ts ./features/**/*.feature --format progress --format allure-cucumberjs/reporter",
    "test:allure": "npm run test",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "test:qa1": "cross-env TEST_ENV=qa1 npm run test",
    "test:qa2": "cross-env TEST_ENV=qa2 npm run test",
    "test:env": "cross-env TEST_ENV=$npm_config_env npm run test",
    "test:playwright": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:report": "npx playwright show-report",
    "test:debug": "npx playwright test --debug",
    "cucumber": "npx cucumber-js --require-module ts-node/register --require ./step-definitions/**/*.ts ./features/**/*.feature",
    "mcp:start": "node mcp-server/server.js",
    "mcp:start:ts": "ts-node ./mcp-server/src/server.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.40.0",
    "@types/chai": "^4.3.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "chai": "^4.3.7",
    "cross-env": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  }
}
